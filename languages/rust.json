{
  "name": "rust",
  "extensions": [".rs"],
  "aliases": ["rs"],
  "line_comments": ["//"],
  "block_comments": [["/*", "*/"]],
  "case_sensitive": true,
  "string_quotes": ["\""],
  "numeric_calls": true,
  "keywords": {
    "0.3": ["self"],
    "0.5": ["use", "mod", "pub", "crate", "const", "static", "Self", "extern"],
    "0.8": ["as"],
    "1.0": ["fn", "let", "mut", "impl", "type", "where", "dyn", "move", "ref"],
    "1.5": ["return", "break", "continue", "async", "await", "unsafe", "panic"],
    "2.0": ["struct", "enum", "trait", "in", "Some", "None", "Ok", "Err", "true", "false", "super"],
    "2.5": ["if", "else", "for", "while", "loop", "match"]
  },
  "operators": ["<", "<=", ">", ">=", "==", "!=", "+", "-", "*", "/", "%", "+=", "-=", "*=", "/=", "%=", "&&", "||", "!", "&", "|", "^", "<<", ">>", "->", "=>", "?", "::", "..", "..="]
}
