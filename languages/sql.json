{
  "name": "sql",
  "extensions": [".sql", ".psql", ".ddl"],
  "aliases": ["postgres", "mysql", "tsql"],
  "line_comments": ["--"],
  "block_comments": [["/*", "*/"]],
  "case_sensitive": false,
  "string_quotes": ["'"],
  "numeric_calls": true,
  "keywords": {
    "0.8": ["as", "by", "into", "values", "set", "table"],
    "1.5": ["select", "from", "insert", "update", "delete", "create", "drop", "alter", "distinct"],
    "2.0": ["join", "inner", "left", "right", "outer", "full", "cross", "on", "group", "order", "union", "limit", "offset", "null", "count", "sum", "avg", "min", "max", "asc", "desc"],
    "2.5": ["where", "having", "and", "or", "case", "when", "then", "else", "end", "between", "like", "in", "exists", "is"],
    "3.0": ["not"]
  },
  "operators": ["=", "<", ">", "<=", ">=", "<>", "!=", "+", "-", "*", "/", "%", "||"]
}
