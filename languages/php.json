{
  "name": "php",
  "extensions": [".php", ".phtml", ".php5"],
  "interpreters": ["php"],
  "aliases": [],
  "line_comments": ["//", "#"],
  "block_comments": [["/*", "*/"]],
  "case_sensitive": false,
  "string_quotes": ["\"", "'"],
  "numeric_calls": true,
  "keywords": {
    "0.3": ["this", "php"],
    "0.5": ["namespace", "use", "require", "require_once", "include", "include_once", "public", "private", "protected", "static", "final", "abstract"],
    "1.0": ["function", "new", "var"],
    "1.5": ["return", "throw", "try", "catch", "finally", "break", "continue", "echo", "print", "yield"],
    "2.0": ["class", "interface", "trait", "extends", "implements", "instanceof", "null", "true", "false", "isset", "empty", "count", "array"],
    "2.5": ["if", "elseif", "else", "for", "foreach", "while", "do", "switch", "case", "default", "match", "and", "or", "xor"]
  },
  "operators": ["<", "<=", ">", ">=", "==", "!=", "===", "!==", "<>", "<=>", "+", "-", "*", "/", "%", "**", ".", "+=", "-=", "*=", "/=", "%=", ".=", "&&", "||", "!", "&", "|", "^", "<<", ">>", "->", "=>", "::", "??", "??=", "?"]
}
