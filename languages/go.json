{
  "name": "go",
  "extensions": [".go"],
  "aliases": ["golang"],
  "line_comments": ["//"],
  "block_comments": [["/*", "*/"]],
  "case_sensitive": true,
  "string_quotes": ["\"", "`"],
  "numeric_calls": true,
  "keywords": {
    "0.5": ["package", "import", "var", "const", "type"],
    "1.0": ["func"],
    "1.5": ["return", "go", "defer", "break", "continue", "panic"],
    "2.0": ["struct", "interface", "map", "chan", "range", "nil", "true", "false", "make", "len", "cap", "append"],
    "2.5": ["if", "else", "for", "switch", "case", "default", "select", "fallthrough"]
  },
  "operators": ["<", "<=", ">", ">=", "==", "!=", "+", "-", "*", "/", "%", "+=", "-=", "*=", "/=", "%=", "&&", "||", "!", "&", "|", "^", "<<", ">>", "<-", ":=", "++", "--", "..."]
}
