{
  "name": "kotlin",
  "extensions": [".kt", ".kts"],
  "aliases": ["kt"],
  "line_comments": ["//"],
  "block_comments": [["/*", "*/"]],
  "case_sensitive": true,
  "string_quotes": ["\""],
  "numeric_calls": true,
  "keywords": {
    "0.3": ["this"],
    "0.5": ["package", "import", "public", "private", "protected", "internal", "open", "const", "lateinit", "abstract", "final", "override"],
    "1.0": ["fun", "val", "var"],
    "1.5": ["return", "throw", "try", "catch", "finally", "break", "continue", "suspend"],
    "2.0": ["class", "interface", "object", "enum", "in", "is", "as", "null", "true", "false", "super"],
    "2.5": ["if", "else", "for", "while", "do", "when"]
  },
  "operators": ["<", "<=", ">", ">=", "==", "!=", "===", "!==", "+", "-", "*", "/", "%", "+=", "-=", "*=", "/=", "%=", "&&", "||", "!", "!!", "?:", "?.", "->", "..", "::"]
}
